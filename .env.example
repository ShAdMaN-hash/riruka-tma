# Blank provider settings start the built-in demo.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric IDs allowed to use a live provider.
TELEGRAM_ALLOWED_USER_IDS=
# Hermes Agent OpenAI-compatible API. Do not use localhost on a hosted deployment.
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

# Optional OpenAI-compatible fallback.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional task execution through a separate, restricted Hermes profile.
HERMES_TASKS_ENABLED=false
HERMES_TASK_BASE_URL=
HERMES_TASK_API_KEY=
